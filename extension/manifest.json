{
  "manifest_version": 3,
  "name": "redactgate",
  "version": "0.1.0",
  "description": "Redacts personal data when you paste into an AI chat, using the redactgate service on your own computer, and puts it back into the answer.",
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": ["http://127.0.0.1:8840/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
